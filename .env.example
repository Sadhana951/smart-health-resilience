# ==============================================================================
# SMART HEALTH & SUPPLY CHAIN RESILIENCE PLATFORM - CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000

# Google Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
FIREBASE_PROJECT_ID=smart-health-resilience-demo
FIREBASE_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=smart-health-resilience-demo

# Frontend Variables (Vite requires VITE_ prefix)
VITE_BACKEND_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=smart-health-resilience.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-health-resilience-demo
VITE_FIREBASE_STORAGE_BUCKET=smart-health-resilience.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
